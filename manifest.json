{
  "manifest_version": 3,
  "name": "Instagram Cleaner - All-in-One",
  "version": "1.1.0",
  "description": "Clean up Following and liked Instagram photos/Reels with native page controls",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "likes-engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
