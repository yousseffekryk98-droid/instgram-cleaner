{
  "manifest_version": 3,
  "name": "Instagram Cleaner - Remove Likes",
  "version": "1.3.0",
  "description": "Batch cleanup of Instagram Likes via native UI with detailed diagnostics",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "likes-engine.js",
        "content.js",
        "likes-auto.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
